# Required for cloud transcription and embeddings
ASSEMBLYAI_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here

# Required for local Whisper with speaker diarization
HF_TOKEN=your_huggingface_token_here

# Optional: Telemetry with Langfuse
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Qdrant configuration (defaults to localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional: API server port (defaults to 3000)
PORT=3000

# Optional: Presidio Analyzer URL (defaults to localhost:5002)
PRESIDIO_ANALYZER_URL=http://localhost:5002
